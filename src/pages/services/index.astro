---
import Base from "../../layouts/Base.astro";
import { site, services } from "../../site.config";
---
<Base title={`Remodeling Services in Bergen County, NJ | ${site.shortName}`} description="Kitchen and bathroom remodeling, decks, additions and basement finishing across Bergen County, NJ.">
  <section class="grid-paper text-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
      <h1 class="wide font-black text-4xl sm:text-6xl leading-none tracking-tight">Services</h1>
      <p class="mt-5 text-xl max-w-[44ch]">Five kinds of work, all done by our own crews. Every job starts with a free walkthrough and a fixed price.</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <ul class="border-t-2 border-blueprint">
      {services.map((s) => (
        <li class="border-b border-line py-10 grid gap-6 lg:grid-cols-[1fr_1fr]">
          <div>
            <h2 class="wide font-extrabold text-2xl sm:text-3xl text-blueprint leading-tight">
              <a href={`/services/${s.slug}`} class="hover:underline underline-offset-4">{s.name}</a>
            </h2>
            <p class="mt-3 prose-measure">{s.summary}</p>
            <p class="mt-3 text-sm"><span class="text-blueprint/70">Typical job:</span> <span class="font-semibold">{s.timeline}</span></p>
          </div>
          <ul class="space-y-2 lg:pt-1">
            {s.includes.map((i) => <li class="pl-5 relative before:absolute before:left-0 before:top-[0.6em] before:w-2.5 before:h-2.5 before:bg-hivis">{i}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>
</Base>
