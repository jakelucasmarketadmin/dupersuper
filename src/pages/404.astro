---
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
---
<Base title={`Page not found | ${site.shortName}`}>
  <section class="grid-paper text-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-24">
      <h1 class="wide font-black text-4xl sm:text-6xl leading-none tracking-tight">This page isn't on the plans</h1>
      <p class="mt-5 text-xl max-w-[44ch]">The link may be old or mistyped. Head back home or go straight to an estimate.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="bg-hivis text-blueprint-deep font-semibold px-5 py-3 hover:bg-white">Go to the homepage</a>
        <a href="/contact" class="border-2 border-line font-semibold px-5 py-3 hover:border-hivis hover:text-hivis">Get a free estimate</a>
      </div>
    </div>
  </section>
</Base>
